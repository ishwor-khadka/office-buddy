{
  "exercises": [
    {
      "id": "neck_chin_tucks",
      "title": "Chin Tucks",
      "bodyPart": "Neck",
      "difficulty": "Easy",
      "durationSeconds": 60,
      "instructions": [
        "Sit tall with shoulders relaxed.",
        "Gently pull your chin straight back (make a double-chin).",
        "Hold 3 seconds, then relax.",
        "Repeat slowly."
      ]
    },
    {
      "id": "neck_rotations",
      "title": "Neck Rotations",
      "bodyPart": "Neck",
      "difficulty": "Easy",
      "durationSeconds": 60,
      "instructions": [
        "Turn your head to look over your right shoulder.",
        "Hold 5 seconds, return to center.",
        "Repeat to the left.",
        "Keep shoulders down."
      ]
    },
    {
      "id": "neck_ear_to_shoulder",
      "title": "Ear-to-Shoulder Stretch",
      "bodyPart": "Neck",
      "difficulty": "Easy",
      "durationSeconds": 60,
      "instructions": [
        "Tilt your right ear toward your right shoulder.",
        "Hold 15 seconds, switch sides.",
        "Do not raise your shoulder."
      ]
    },
    {
      "id": "neck_flexion_extension",
      "title": "Neck Flexion and Extension",
      "bodyPart": "Neck",
      "difficulty": "Easy",
      "durationSeconds": 60,
      "instructions": [
        "Slowly tuck chin and look down.",
        "Return to neutral, then gently look up.",
        "Move within a comfortable range."
      ]
    },
    {
