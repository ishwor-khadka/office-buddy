      "title": "SCM Stretch",
      "bodyPart": "Neck",
      "difficulty": "Medium",
      "durationSeconds": 60,
      "instructions": [
        "Turn head to the right and slightly look up.",
        "Place left hand on collarbone to anchor.",
        "Hold 15 seconds, switch sides."
      ]
    },
    {
      "id": "neck_levator_scapulae",
      "title": "Levator Scapulae Stretch",
      "bodyPart": "Neck",
      "difficulty": "Medium",
      "durationSeconds": 60,
      "instructions": [
        "Turn head 45 degrees to the right.",
        "Look down toward your armpit.",
        "Hold 15 seconds, switch sides."
      ]
    },

    {
