rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isNonEmptyString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function isOptionalString(value, maxLen) {
      return value == null || (value is string && value.size() <= maxLen);
    }

    function isValidAmount(value) {
      return value is string && value.matches('^\\d+(\\.\\d{1,2})?$');
    }

    function isValidDateLabel(value) {
      return value is string && value.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isMillis(value) {
      return value is int && value > 0;
    }

    function isValidExpensePayload(data) {
      return data.keys().hasOnly([
          'amount',
          'currencyCode',
          'category',
          'description',
          'dateLabel',
          'expenseDateMillis',
          'createdAtMillis',
          'updatedAt'
        ])
        && isValidAmount(data.amount)
        && isNonEmptyString(data.currencyCode, 8)
        && isNonEmptyString(data.category, 64)
        && (data.description == null || isOptionalString(data.description, 200))
        && isValidDateLabel(data.dateLabel)
        && isMillis(data.expenseDateMillis)
        && isMillis(data.createdAtMillis)
        && (data.updatedAt == null || data.updatedAt is timestamp);
    }

    function isValidHydrationPayload(data) {
      return data.keys().hasOnly([
          'timestampMillis',
          'amountMl',
          'createdAt'
        ])
        && isMillis(data.timestampMillis)
        && data.amountMl is int
        && data.amountMl > 0
        && data.amountMl <= 2000
        && data.createdAt is int;
    }

    match /motivational_quotes/{quoteId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      match /expenses/{expenseId} {
        allow create: if isOwner(userId) && isValidExpensePayload(request.resource.data);
        allow update: if isOwner(userId)
          && request.resource.data.createdAtMillis == resource.data.createdAtMillis
          && isValidExpensePayload(request.resource.data);
        allow delete: if isOwner(userId);
        allow read: if isOwner(userId);
      }

      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /hydration_logs/{logId} {
        allow create: if isOwner(userId) && isValidHydrationPayload(request.resource.data);
        allow read: if isOwner(userId);
        allow update, delete: if false;
      }

      match /device_tokens/{tokenId} {
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'token',
            'platform',
            'updatedAtMillis'
          ])
          && isNonEmptyString(request.resource.data.token, 1024)
          && isNonEmptyString(request.resource.data.platform, 32)
          && isMillis(request.resource.data.updatedAtMillis);
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
